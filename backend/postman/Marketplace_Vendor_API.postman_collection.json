{
  "info": {
    "_postman_id": "b6e6f1a0-6c1a-4a3e-9d0a-ad06vendorapi01",
    "name": "Marketplace — Vendor API",
    "description": "Collection for the Vendor-facing mobile API (`routes/api_vendor.php`), guard `vendor.auth` -> `vendor.active` (JWT).\n\nSet `base_url` and `access_token` collection variables (obtain the token via Vendor Auth Login, not included here — see AS-06 ticket scope). This initial collection covers the AS-06 Ad Slots feature: browsing bookable ad slots, quoting, booking, uploading creatives, submitting for review, paying, cancelling and viewing stats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "https://api.marketplace.test", "description": "API host, no trailing slash" },
    { "key": "access_token", "value": "", "description": "Vendor JWT access token" },
    { "key": "ad_slot_id", "value": "", "description": "UUID of a PaidAdSlot, set manually after List Ad Slots" },
    { "key": "ad_booking_id", "value": "", "description": "UUID of a PaidAdBooking, set automatically by Create Booking's test script" }
  ],
  "item": [
    {
      "name": "Vendor · Ad Slots",
      "item": [
        {
          "name": "List Ad Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-slots?surface=page_block",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-slots"],
              "query": [
                { "key": "surface", "value": "page_block", "description": "placement|page_block", "disabled": true },
                { "key": "pricing_model", "value": "", "description": "fixed_daily|fixed_weekly|fixed_monthly|cpm|cpc", "disabled": true }
              ]
            },
            "description": "Only slots bookable() + country_id = vendor country + allowed_advertisers in (vendor, both)."
          }
        },
        {
          "name": "Show Ad Slot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-slots/{{ad_slot_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-slots", "{{ad_slot_id}}"]
            }
          }
        },
        {
          "name": "Slot Calendar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-slots/{{ad_slot_id}}/calendar?month=2026-10",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-slots", "{{ad_slot_id}}", "calendar"],
              "query": [{ "key": "month", "value": "2026-10" }]
            }
          }
        },
        {
          "name": "Quote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booked_from\": \"2026-10-05\",\n  \"booked_until\": \"2026-10-11\",\n  \"budget\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-slots/{{ad_slot_id}}/quote",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-slots", "{{ad_slot_id}}", "quote"]
            }
          }
        },
        {
          "name": "Search Destinations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-slots/destinations?type=listing&q=",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-slots", "destinations"],
              "query": [
                { "key": "type", "value": "listing", "description": "listing|classified_listing|store|brand|category" },
                { "key": "q", "value": "" }
              ]
            },
            "description": "Route declared before {id} so this literal segment is matched first."
          }
        }
      ]
    },
    {
      "name": "Vendor · Ad Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings?status=active",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings"],
              "query": [{ "key": "status", "value": "active", "disabled": true }]
            }
          }
        },
        {
          "name": "Create Booking (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('ad_booking_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{ad_slot_id}}\",\n  \"booked_from\": \"2026-10-05\",\n  \"booked_until\": \"2026-10-11\",\n  \"budget\": null,\n  \"payment_method\": \"payout_deduction\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings"]
            }
          }
        },
        {
          "name": "Show Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}"]
            }
          }
        },
        {
          "name": "Upload Creative",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "desktop_en", "type": "file", "src": [] },
                { "key": "mobile_en", "type": "file", "src": [] },
                { "key": "desktop_ar", "type": "file", "src": [], "disabled": true },
                { "key": "mobile_ar", "type": "file", "src": [], "disabled": true },
                { "key": "title_en", "value": "", "disabled": true },
                { "key": "destination_type", "value": "listing" },
                { "key": "destination_reference_id", "value": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}/creative",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}", "creative"]
            }
          }
        },
        {
          "name": "Submit for Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}", "submit"]
            }
          }
        },
        {
          "name": "Pay",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}/pay",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}", "pay"]
            },
            "description": "422 with {message, required, balance, currency} on InsufficientBalanceException."
          }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"No longer needed\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}", "cancel"]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/vendor/v1/ad-bookings/{{ad_booking_id}}/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "v1", "ad-bookings", "{{ad_booking_id}}", "stats"]
            }
          }
        }
      ]
    }
  ]
}
